# --- Servidor ---
PORT=3000
API_KEY=troque-por-uma-chave-forte
PUBLIC_BASE_URL=https://reels-api.seudominio.com
RENDER_CONCURRENCY=4
JOB_CONCURRENCY=1

# --- Voz (Piper) — TUDO fixo aqui, a API não recebe isso do cliente ---
PIPER_MODEL_PATH=/app/voices/voice.onnx
PIPER_CONFIG_PATH=/app/voices/voice.onnx.json
PIPER_RATE=1.0

# --- Estilo — também fixo, não exposto na API ---
DEFAULT_MIN_DURATION_SECONDS=10
INTRO_DURATION_SECONDS=1.2
SHOW_INTRO=true
DEFAULT_FIT_MODE=contain
DEFAULT_THEME=dark
